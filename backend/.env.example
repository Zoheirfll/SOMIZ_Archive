# ─── SOMIZ Archivage — Variables d'environnement ──────────────────────────────
# Copier ce fichier en .env et remplacer les valeurs par les vraies (jamais
# commiter le .env réel — voir .gitignore).

# Django
SECRET_KEY=change-me-generate-a-long-random-value
DEBUG=False

# Intranet — mettre l'IP/le hostname réel du serveur SOMIZ (pas de CIDR,
# ALLOWED_HOSTS ne le supporte pas)
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100
INTRANET_URL=http://192.168.1.100

# Base de données PostgreSQL
DB_NAME=somiz_archivage
DB_USER=somiz_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Cache Redis (rate-limiting DRF + alerte audit) — si absent, repli sur un
# cache mémoire local (à éviter en prod multi-worker, voir securite.md point 2)
REDIS_URL=redis://127.0.0.1:6379/1

# Cookies JWT — True uniquement en HTTPS
JWT_COOKIE_SECURE=False

# HTTPS (activer en production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Si DEBUG=False et que les cookies ci-dessus restent non-Secure, l'app refuse
# de démarrer sauf confirmation explicite que c'est un intranet HTTP voulu :
INTRANET_HTTP_CONFIRMED=True

# Email (alertes admin — volume de consultation anormal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=somiz@localhost
# Format: nom:email,nom2:email2
ADMINS=
