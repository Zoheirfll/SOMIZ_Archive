# Copier en deploy/.env sur le serveur et remplir. NE JAMAIS COMMITER le .env réel.
# Générer SECRET_KEY :  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Générer un mot de passe : python -c "import secrets; print(secrets.token_urlsafe(32))"

DOMAIN=mzeducation.online

SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=mzeducation.online
INTRANET_URL=https://mzeducation.online
NGROK_URL=
CLOUDFLARE_URL=

DB_NAME=somiz_archivage
DB_USER=somiz_user
DB_PASSWORD=

# HTTPS (Caddy termine le TLS) — les trois flags cookies doivent être True
JWT_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# False volontaire : Caddy redirige déjà HTTP→HTTPS, et Django (sans
# SECURE_PROXY_SSL_HEADER) ne voit que du HTTP en interne → True = boucle infinie.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Intégrations : laisser vide tant que non validées
GRH_WEBHOOK_SECRET=
PLATEFORME_SPS_WEBHOOK_URL=
PLATEFORME_SPS_WEBHOOK_SECRET=

# Alertes email (optionnel)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ADMINS=
